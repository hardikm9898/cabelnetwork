# Copy to .env for local development (never commit .env).
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://cablenet:cablenet_dev@localhost:55432/cablenet
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173
# Public address customers use to open shared receipt links (https://… in production).
# If unset, links use the address the agent's phone used to reach the API.
# PUBLIC_BASE_URL=https://pay.example.in
TRUST_PROXY=false
LOG_LEVEL=info
# Only for `pnpm cli create-super-admin` (letters + digits, min 8). Remove after use.
BOOTSTRAP_PASSWORD=
