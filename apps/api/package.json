{
  "name": "@cablenet/api",
  "version": "0.1.0",
  "private": true,
  "description": "Cable network backend: REST API (/api/v1) and background worker.",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/main.js",
    "dev": "node --env-file-if-exists=.env --watch -r @swc-node/register src/main.ts",
    "db:migrate": "node --env-file-if-exists=.env -r @swc-node/register src/cli.ts migrate",
    "cli": "node --env-file-if-exists=.env -r @swc-node/register src/cli.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@cablenet/contracts": "workspace:*",
    "@cablenet/domain": "workspace:*",
    "@nestjs/common": "11.2.10",
    "@nestjs/core": "11.2.10",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.10",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.8.0",
    "argon2": "0.45.2",
    "exceljs": "4.4.0",
    "helmet": "^8.3.0",
    "kysely": "0.29.9",
    "nestjs-pino": "5.3.2",
    "pdfmake": "0.2.23",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.10",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "1.16.22",
    "@testcontainers/postgresql": "11.14.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/pdfmake": "0.2.13",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.1.1",
    "supertest": "^7.1.4",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "4.1.12"
  }
}
