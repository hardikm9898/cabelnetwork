# Copy to docker/prod.env (never commit it) and fill in every value.
# Generate secrets with:  openssl rand -hex 32

# Public host name of the server (DNS A record → this server). Caddy gets the HTTPS certificate.
SITE_ADDRESS=cable.example.in
# Used in receipt links shared on WhatsApp.
PUBLIC_BASE_URL=https://cable.example.in
# Only for a trial on an internal IP without a domain (plain HTTP, not encrypted):
#   SITE_ADDRESS=:80   PUBLIC_BASE_URL=http://<server-ip>:<HTTP_PORT>   ALLOW_INSECURE_HTTP=true
ALLOW_INSECURE_HTTP=false

# Hex only (it is placed inside the database URL).
POSTGRES_PASSWORD=
# At least 32 characters each, and different from each other.
JWT_ACCESS_SECRET=
RECEIPT_LINK_SECRET=

# Only for the one-time "create-super-admin" command; remove afterwards.
BOOTSTRAP_PASSWORD=

# Leave empty: the office site and the API share one origin, and the phone app does not need CORS.
CORS_ORIGINS=
LOG_LEVEL=info

# Backups (inside the server; copy them off the server too — see RUNBOOK.md).
BACKUP_HOST_DIR=./backups
BACKUP_KEEP_DAYS=35
BACKUP_KEEP_MONTHS=12
# 20:45 UTC = 02:15 IST
BACKUP_AT_UTC=20:45

HTTP_PORT=80
HTTPS_PORT=443
TAG=latest
